// app/layout.tsx
import React from 'react';
import { Html, Head, Main, NextScript } from 'next/document';

export default function Document() {
  return (
    <Html>
      <Head>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="anonymous" />
        <link
          href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet"
        />
        <script
          dangerouslySetInnerHTML={{
            __html: `(function(){var ONCE_KEY="__chunk_reloaded_once";function markAndReload(){try{sessionStorage.setItem(ONCE_KEY,"1")}catch(_){};try{var u=new URL(window.location.href);u.searchParams.set("_",Date.now().toString());window.location.replace(u.toString())}catch(e){window.location.reload()}}function shouldReload(){try{return sessionStorage.getItem(ONCE_KEY)!=="1"}catch(_){return true}}function msg(x){try{return typeof x==="string"?x:(x&&x.message)?String(x.message):""}catch(_){return""}}window.addEventListener("error",function(e){if(!shouldReload())return;var m=msg(e);var f=e&&e.filename?String(e.filename):"";if(m.includes("Loading chunk")||m.includes("ChunkLoadError")||f.includes("/_next/static/chunks/")){markAndReload()}},true);window.addEventListener("unhandledrejection",function(e){if(!shouldReload())return;var r=e&&e.reason;var m=msg(r);var n=r&&r.name;if(m.includes("Loading chunk")||n==="ChunkLoadError"){markAndReload()}},true);})();`,
          }}
        />
      </Head>
      <body>
        <Main />
        <NextScript />
      </body>
    </Html>
  );
}

